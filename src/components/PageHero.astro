---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Optional background photo, shown dimmed behind the text. */
  photo?: ImageMetadata;
  photoAlt?: string;
}

const { eyebrow, title, lead, photo, photoAlt = '' } = Astro.props;
---

<section class="court-lines relative overflow-hidden bg-ink-900">
  {
    photo && (
      <Image
        src={photo}
        alt={photoAlt}
        width={1600}
        class="absolute inset-0 h-full w-full object-cover opacity-25"
        loading="eager"
      />
    )
  }
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-volt-500/25 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="container-x relative py-14 md:py-24">
    <p class="eyebrow text-volt-300">{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-balance text-h1 font-black leading-[1.05] tracking-tight text-white">
      {title}
    </h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-200">{lead}</p>}
  </div>
</section>
