---
import type { Program } from '../data/site';
import { cta } from '../data/site';

interface Props {
  program: Program;
}

const { program } = Astro.props;
const dark = !!program.featured;
const groupLabel = {
  junior: 'Junior',
  adult: 'Adult',
  camp: 'Holiday camp',
  social: 'Social',
}[program.group];
---

<article
  class:list={[
    'flex h-full flex-col rounded-2xl border p-6 transition hover:shadow-lg hover:shadow-ink-900/5',
    dark ? 'border-ink-900 bg-ink-900 text-white' : 'border-ink-100 bg-white',
  ]}
>
  <div class="flex flex-wrap items-center gap-1.5">
    <span
      class:list={[
        'rounded-full px-2.5 py-1 text-[0.7rem] font-semibold',
        dark ? 'bg-ink-800 text-volt-300' : 'bg-shuttle-100 text-ink-700',
      ]}
    >
      {groupLabel}
    </span>
    {
      program.entry === 'selection' && (
        <span
          class:list={[
            'rounded-full px-2.5 py-1 text-[0.7rem] font-semibold',
            dark ? 'bg-volt-500 text-white' : 'bg-navy text-white',
          ]}
        >
          By selection
        </span>
      )
    }
  </div>

  <h3 class:list={['mt-4 text-xl font-bold tracking-tight', dark ? 'text-white' : 'text-ink-900']}>
    {program.name}
  </h3>
  <p class:list={['mt-1 text-sm font-semibold', dark ? 'text-volt-300' : 'text-navy']}>
    {program.audience}
  </p>
  <p class:list={['mt-3 flex-1 text-sm leading-relaxed', dark ? 'text-ink-200' : 'text-ink-600']}>
    {program.summary}
  </p>

  <dl
    class:list={[
      'mt-5 grid grid-cols-2 gap-3 border-t pt-4 text-sm',
      dark ? 'border-ink-700' : 'border-ink-100',
    ]}
  >
    <div>
      <dt class="text-xs font-semibold text-ink-400">When</dt>
      <dd class:list={['mt-0.5 font-medium', dark ? 'text-white' : 'text-ink-900']}>
        {program.days.join(' & ')}<br />{program.time}
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold text-ink-400">Price</dt>
      <dd class:list={['mt-0.5 font-medium', dark ? 'text-white' : 'text-ink-900']}>
        <span class="text-lg font-black">{program.price}</span>
        <span class="text-xs">{program.basis}</span>
      </dd>
    </div>
  </dl>
  <p class:list={['mt-3 text-xs leading-relaxed', dark ? 'text-ink-300' : 'text-ink-500']}>
    {program.note}
  </p>

  <a
    href={`${cta.href}?programme=${program.slug}`}
    class:list={[
      'mt-5 rounded-lg px-4 py-2.5 text-center text-sm font-bold transition',
      dark ? 'bg-volt-500 text-white hover:bg-volt-400' : 'bg-navy text-white hover:bg-ink-800',
    ]}
  >
    {program.entry === 'selection' ? 'Ask about selection' : cta.label}
  </a>
</article>
