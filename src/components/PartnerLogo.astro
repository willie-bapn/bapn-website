---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Partner } from '../data/site';

interface Props {
  partner: Partner;
  tall?: boolean;
}

const { partner, tall = false } = Astro.props;

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.{png,jpg}', {
  eager: true,
});
const logo =
  logos[`../assets/partners/${partner.logo}.png`]?.default ??
  logos[`../assets/partners/${partner.logo}.jpg`]?.default;
---

<a
  href={partner.href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'grid place-items-center rounded-xl border border-ink-100 px-6 transition hover:border-navy/40',
    partner.logoBg === 'dark' ? 'bg-ink-900' : 'bg-white',
    tall ? 'h-36' : 'h-24',
  ]}
  aria-label={`${partner.name} (opens in a new tab)`}
>
  {
    logo ? (
      <Image
        src={logo}
        alt={partner.name}
        width={400}
        class:list={['w-auto object-contain', tall ? 'max-h-24' : 'max-h-14']}
      />
    ) : (
      <span class="text-xs font-semibold text-ink-400">{partner.name}</span>
    )
  }
</a>
