---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { schools, site } from '../data/site';
import heroPhoto from '../assets/photos/p04.jpg';
import teamPhoto from '../assets/photos/rangi-ruru-team.jpg';
---

<Base
  title="Schools"
  description="BAPN coaches badminton in Canterbury schools — weekly coaching, term blocks and tournament preparation, on site and built around the school timetable."
>
  <PageHero
    eyebrow="BAPN in schools"
    title="Badminton coaching, at your school."
    lead={schools.intro}
    photo={heroPhoto}
    photoAlt="A BAPN coach working with a group of school-age players"
  />

  <!-- What we offer -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-navy">What we offer</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
          Built around your timetable, coached to BAPN's standard.
        </h2>
        <p class="mt-4 text-ink-600">
          The same coaches, the same structured approach as the academy — delivered on your courts.
          Every BAPN coach is assessed and approved by the academy, and our head coaches hold BWF
          certification and head-coach roles with Badminton Canterbury.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          schools.offers.map((o, i) => (
            <div class="rounded-2xl border border-ink-100 bg-white p-6">
              <span class="text-sm font-black tracking-widest text-volt-500">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-bold tracking-tight text-ink-900">{o.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{o.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Result -->
  <section class="court-lines bg-ink-900 py-16 md:py-24">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow text-volt-300">Results</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-white">
          Back-to-back gold at the South Island Secondary Schools Championships.
        </h2>
        <p class="mt-4 text-ink-200">
          BAPN is the coaching partner of Rangi Ruru Girls' High School's badminton programme. With
          weekly coaching and tournament support from BAPN, the team won gold two years running — a
          reminder of how much school badminton can grow with the right support.
        </p>
        <a href="/news/rangi-ruru-south-island-gold" class="btn-ghost-light mt-6">Read the story</a>
      </div>
      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-3xl border border-ink-700">
          <Image
            src={teamPhoto}
            alt="The Rangi Ruru badminton team with their BAPN coach"
            width={1200}
            height={1200}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Schools we work with -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-navy">Schools we work with</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Across Canterbury</h2>
        <p class="mt-4 text-ink-600">
          BAPN is committed to giving back to the community and helping grow the sport in Canterbury
          schools.
        </p>
      </div>
      <ul class="grid gap-4 lg:col-span-7">
        {
          schools.schools.map((s) => (
            <li class="rounded-2xl border border-ink-100 bg-white p-5">
              <p class="font-bold text-ink-900">{s.name}</p>
              <p class="mt-1 text-sm text-ink-600">{s.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How it works / CTA -->
  <section class="border-t border-ink-100 bg-white py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow text-navy">How it starts</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Tell us about your school.</h2>
        <ol class="mt-6 space-y-4 text-ink-600">
          {
            [
              'Get in touch with roughly how many players, what year groups, and when badminton fits in the week.',
              'We suggest a format — weekly coaching, a term block, or tournament prep — and which coach.',
              'We agree the term dates and the cost, and the coach turns up with the shuttles.',
            ].map((step, i) => (
              <li class="flex gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-navy text-xs font-black text-white">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-ink-100 bg-shuttle-50 p-6 md:p-8">
          <p class="text-lg font-bold text-ink-900">For teachers and sports coordinators</p>
          <p class="mt-2 text-sm text-ink-600">
            Send us a message and a head coach will come back to you.
          </p>
          <a href="/contact?topic=schools" class="btn-primary mt-5 w-full text-center">Contact us about your school</a>
          <p class="mt-4 text-sm text-ink-500">
            Or email <a href={`mailto:${site.email}`} class="font-semibold text-navy underline">{site.email}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
