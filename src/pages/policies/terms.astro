---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PolicySection from '../../components/PolicySection.astro';
import { policyMeta, sections } from '../../data/policies';
---

<Base
  title="Player Agreement & Terms"
  description="BAPN Badminton Academy Terms of Engagement and Player Agreement — registration, fees, refunds, conduct, safety, privacy."
>
  <PageHero eyebrow="Policies" title={policyMeta.title} lead={`${policyMeta.effective}. ${policyMeta.applies}`} />

  <div class="bg-shuttle-50 py-12 md:py-16">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <nav class="lg:col-span-3" aria-label="Sections">
        <div class="rounded-2xl border border-ink-100 bg-white p-5 lg:sticky lg:top-24">
          <p class="eyebrow text-ink-400">Contents</p>
          <ol class="mt-3 space-y-1.5 text-sm">
            {
              sections.map((s) => (
                <li>
                  <a href={`#s${s.n}`} class="text-ink-700 transition hover:text-navy">
                    {s.n}. {s.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </nav>
      <div class="space-y-10 lg:col-span-9">
        <p class="rounded-2xl border border-ink-100 bg-white p-5 text-sm text-ink-600">
          Every player (and a parent or guardian for players under 18) signs this agreement once a
          year, before their first session. The signed version is the one that applies; this page is
          the same wording, for reference.
        </p>
        {sections.map((s) => <PolicySection section={s} />)}
        <p class="rounded-2xl border border-ink-100 bg-white p-5 text-sm text-ink-600">
          Privacy contact: {policyMeta.privacyContact.name},
          <a href={`mailto:${policyMeta.privacyContact.email}`} class="font-semibold text-navy underline">
            {policyMeta.privacyContact.email}
          </a>
        </p>
      </div>
    </div>
  </div>
</Base>
