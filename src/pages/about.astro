---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CoachCard from '../components/CoachCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { coaches } from '../data/site';
import heroPhoto from '../assets/photos/p17.jpg';
import squadPhoto from '../assets/photos/p15.jpg';
import workshopPhoto from '../assets/photos/p10.jpg';

const philosophy = [
  {
    n: '01',
    title: 'Fundamentals first',
    body: 'Grip, footwork, balance, technique. Then the coaching is shaped to the player — age, goals, how they learn.',
  },
  {
    n: '02',
    title: 'Learn, practise, compete, review',
    body: "A skill isn't learned until it holds up in a match. Understand it, drill it, test it under pressure, look back.",
  },
  {
    n: '03',
    title: 'Players who think for themselves',
    body: 'Questions, not answers. Players learn to read the game, spot patterns and decide what to change.',
  },
  {
    n: '04',
    title: 'The long game',
    body: "Habits, discipline, resilience and respect — qualities that carry well beyond badminton.",
  },
];

const headCoaches = coaches.filter((c) => c.role.startsWith('Head Coach'));
const assistants = coaches.filter((c) => !c.role.startsWith('Head Coach'));
---

<Base
  title="About"
  description="Why BAPN started, how we coach, and the coaches behind Badminton Academy Performance & Nutrition, Christchurch."
>
  <PageHero
    eyebrow="About BAPN"
    title="Built by coaches who wanted a better pathway."
    lead="Three Badminton Canterbury coaches started BAPN because Christchurch players needed experienced coaching and a clear way to improve."
    photo={heroPhoto}
    photoAlt="A BAPN coach demonstrating technique on court"
  />

  <!-- Why we started -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow text-navy">Why we started</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
          The programme every player deserves.
        </h2>
        <div class="mt-5 space-y-4 text-ink-600">
          <p>
            The founders brought national and international playing careers, recognised coaching
            qualifications and a track record of developing competitive players.
          </p>
          <p>
            Training follows a clear pathway with high standards at every level. National and
            international coaches and players are regularly invited in to work with the squad.
          </p>
          <p class="font-semibold text-ink-900">
            Juniors building foundations, adults lifting their game — the right coaching at every
            stage.
          </p>
        </div>
      </div>
      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-3xl border border-ink-100">
          <Image
            src={squadPhoto}
            alt="A BAPN junior mid jump-smash during squad training"
            width={1200}
            height={800}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="border-t border-ink-100 bg-white py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-navy">How we coach</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Four things in every session</h2>
        <p class="mt-4 text-ink-600">
          From a first racket to a first tournament, the approach is the same.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
        {
          philosophy.map((p) => (
            <div class="card bg-shuttle-50 p-6">
              <span class="text-sm font-black tracking-widest text-volt-500">{p.n}</span>
              <h3 class="mt-3 text-lg font-bold tracking-tight text-ink-900">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Nutrition -->
  <section id="nutrition" class="court-lines scroll-mt-24 bg-ink-900 py-16 md:py-24">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12">
      <div class="order-2 lg:order-1 lg:col-span-6">
        <div class="overflow-hidden rounded-3xl border border-ink-700">
          <Image
            src={workshopPhoto}
            alt="A partner health professional running a recovery session with BAPN players"
            width={1200}
            height={800}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="order-1 lg:order-2 lg:col-span-6">
        <p class="eyebrow text-volt-300">The "N" in BAPN</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-white">
          Looking after the body is part of the game.
        </h2>
        <p class="mt-4 text-ink-200">
          How players fuel, recover and handle soreness matters as much as time on court. So
          qualified health professionals come into training and teach it hands-on:
        </p>
        <ul class="ticks mt-5 text-ink-200">
          <li>Food and hydration around training</li>
          <li>Stretching, muscle release and simple recovery tools</li>
          <li>Telling normal soreness from an injury — and what to do about it</li>
        </ul>
        <p class="mt-5 text-ink-200">
          Led by <strong class="text-white">Diana Chen</strong>, registered physiotherapist and
          founder of Halo Health Physio, with chiropractor <strong class="text-white">Jacob</strong>
          every term.
        </p>
      </div>
    </div>
  </section>

  <!-- Coaches -->
  <section id="coaches" class="scroll-mt-24 bg-shuttle-50 py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-navy">The team</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Head coaches</h2>
        <p class="mt-4 text-ink-600">
          BWF-certified, with head-coach roles at Badminton Canterbury and playing careers at
          national level.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {headCoaches.map((coach) => <CoachCard coach={coach} />)}
      </div>

      <div class="mt-16 max-w-2xl">
        <h2 class="text-h2 font-black tracking-tight text-ink-900">Assistant coaches</h2>
        <p class="mt-4 text-ink-600">
          Assessed and approved by BAPN. Most hold BWF Shuttle Time certification.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {assistants.map((coach) => <CoachCard coach={coach} compact />)}
      </div>
    </div>
  </section>

  <CtaBand
    title="Come and watch a session"
    body="The best way to judge an academy is to see one train."
  />
</Base>
