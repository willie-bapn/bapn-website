---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { news } from '../../data/site';

export function getStaticPaths() {
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', {
  eager: true,
});
const photo = photos[`../../assets/photos/${item.photo}.jpg`]?.default;
const others = news.filter((n) => n.slug !== item.slug).slice(0, 3);
---

<Base title={item.title} description={item.excerpt}>
  <article>
    <header class="court-lines bg-ink-900">
      <div class="container-x py-14 md:py-20">
        <a href="/news" class="text-sm font-semibold text-ink-300 transition hover:text-volt-300">← All news</a>
        <div class="mt-6 flex items-center gap-3 text-xs">
          <span class="rounded-full bg-volt-500 px-2.5 py-1 font-bold text-white">{item.category}</span>
          <time class="font-medium text-ink-300">{item.date}</time>
        </div>
        <h1 class="mt-4 max-w-3xl text-balance text-h1 font-black leading-[1.05] tracking-tight text-white">
          {item.title}
        </h1>
      </div>
    </header>

    <div class="bg-shuttle-50 py-12 md:py-16">
      <div class="container-x grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          {
            photo && (
              <div class="overflow-hidden rounded-2xl border border-ink-100">
                <Image src={photo} alt="" width={1200} class="h-auto w-full" />
              </div>
            )
          }
          <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-700">
            {item.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <aside class="lg:col-span-4">
          <h2 class="eyebrow text-ink-400">More news</h2>
          <ul class="mt-4 space-y-3">
            {
              others.map((n) => (
                <li>
                  <a
                    href={`/news/${n.slug}`}
                    class="block rounded-xl border border-ink-100 bg-white p-4 text-sm font-bold leading-snug text-ink-900 transition hover:border-navy/40"
                  >
                    {n.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </article>

  <CtaBand />
</Base>
