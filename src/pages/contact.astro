---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.venue.mapQuery)}&output=embed`;
---

<Base
  title="Contact"
  description="Get in touch with BAPN — Badminton Academy Performance & Nutrition, Zhu Badminton Centre, Wigram, Christchurch."
>
  <PageHero
    eyebrow="Contact"
    title="Get in touch."
    lead="Not sure which programme suits, want to watch a session, or interested in partnering? Send us a message."
  />

  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <form
          name="contact"
          method="POST"
          action="/thanks"
          data-netlify="true"
          netlify-honeypot="company"
          class="rounded-2xl border border-ink-100 bg-white p-6 md:p-8"
          id="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this in: <input name="company" /></label>
          </p>
          <h2 class="text-xl font-black tracking-tight text-ink-900">Send us a message</h2>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold text-ink-900">Your name</span>
              <input required name="name" autocomplete="name" class="field" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-ink-900">Email</span>
              <input required type="email" name="email" autocomplete="email" class="field" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-ink-900"
                >Phone <span class="font-normal text-ink-400">(optional)</span></span
              >
              <input type="tel" name="phone" autocomplete="tel" class="field" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-ink-900">What's this about?</span>
              <select name="topic" id="topic" class="field">
                <option value="joining">Joining the academy</option>
                <option value="private">Private coaching</option>
                <option value="camps">Holiday camps</option>
                <option value="membership">Membership</option>
                <option value="schools">School coaching</option>
                <option value="partnership">Partnership / sponsorship</option>
                <option value="other">Something else</option>
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-semibold text-ink-900">Message</span>
              <textarea required name="message" rows="5" class="field"></textarea>
            </label>
          </div>

          <button type="submit" class="btn-dark mt-6">Send message</button>
          <p class="mt-3 text-xs text-ink-400">
            We reply by email, usually within two working days.
          </p>
        </form>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-ink-100 bg-white p-6 md:p-8">
          <h2 class="eyebrow text-ink-400">Where we train</h2>
          <address class="mt-4 space-y-1 text-base not-italic leading-relaxed text-ink-900">
            <p class="font-bold">{site.venue.name}</p>
            <p class="text-ink-600">{site.venue.address}</p>
            <p class="text-ink-600">{site.venue.suburb}</p>
          </address>

          <div class="mt-6 space-y-2 text-sm">
            <p>
              <span class="font-semibold text-ink-900">Email</span>
              <a href={`mailto:${site.email}`} class="ml-2 text-navy underline">{site.email}</a>
            </p>
            {
              site.phone && (
                <p>
                  <span class="font-semibold text-ink-900">Phone</span>
                  <a href={`tel:${site.phone}`} class="ml-2 text-navy underline">{site.phone}</a>
                </p>
              )
            }
          </div>

          <div class="mt-6 flex gap-2">
            {
              site.socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-ink-200 px-4 py-2 text-sm font-semibold text-ink-900 transition hover:border-navy"
                >
                  {s.label}
                </a>
              ))
            }
          </div>

          <div class="mt-6 overflow-hidden rounded-xl border border-ink-100">
            <iframe
              src={mapSrc}
              width="100%"
              height="280"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Map of ${site.venue.name}`}
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Pre-select the topic when linked as /contact?topic=schools
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>
