---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { partners, sponsorship } from '../data/site';
import heroPhoto from '../assets/photos/p21.jpg';
---

<Base
  title="Partners"
  description="The businesses supporting BAPN badminton in Christchurch, and how to partner with the academy."
>
  <PageHero
    eyebrow="Partners"
    title="The people who make this possible."
    lead="Our partners support the academy all year round — gear, gifts for players, health and recovery sessions, and member discounts. Thank you."
    photo={heroPhoto}
    photoAlt="BAPN players with partners at a presentation"
  />

  <!-- Current partners -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x grid gap-6 md:grid-cols-2">
      {
        partners.map((p) => (
          <article class="card flex h-full flex-col p-6">
            <PartnerLogo partner={p} tall />
            <span class="pill pill-muted mt-5 self-start">{p.tier}</span>
            <h2 class="mt-2 text-xl font-bold tracking-tight text-ink-900">{p.name}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{p.blurb}</p>
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 text-sm font-bold text-navy transition hover:text-volt-500"
            >
              Visit {p.name} →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Partner with BAPN -->
  <section class="border-t border-ink-100 bg-white py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-navy">Partner with BAPN</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
          Support badminton in Canterbury, on and off the court.
        </h2>
        <p class="mt-4 text-ink-600">{sponsorship.intro}</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          sponsorship.tiers.map((t) => (
            <div class:list={['flex h-full flex-col p-6', t.featured ? 'card-dark' : 'card bg-shuttle-50']}>
              <h3 class:list={['text-lg font-black uppercase tracking-wide', t.featured ? 'text-volt-300' : 'text-ink-900']}>
                {t.name}
              </h3>
              {t.label && <p class="text-xs font-semibold text-ink-400">{t.label}</p>}

              <dl class:list={['mt-4 grid grid-cols-2 gap-3 border-y py-4 text-sm', t.featured ? 'border-ink-700' : 'border-ink-100']}>
                <div>
                  <dt class="text-xs text-ink-400">Cash</dt>
                  <dd class="mt-0.5 font-black">{t.cash}</dd>
                </div>
                <div>
                  <dt class="text-xs text-ink-400">or product</dt>
                  <dd class="mt-0.5 font-black">{t.product}</dd>
                </div>
              </dl>

              <ul class:list={['ticks mt-4 flex-1', t.featured ? 'text-ink-200' : 'text-ink-600']}>
                {t.perks.map((perk) => (
                  <li>{perk}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <a href="/contact?topic=partnership" class="btn-dark mt-10">Talk to us about partnering</a>
    </div>
  </section>
</Base>
