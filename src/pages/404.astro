---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="court-lines bg-ink-900">
    <div class="container-x py-20 md:py-28">
      <p class="eyebrow text-volt-300">404</p>
      <h1 class="mt-4 max-w-2xl text-h1 font-black leading-[1.05] tracking-tight text-white">
        Out. That page isn't here.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-200">
        The link may be old, or the address mistyped. Everything on the site is one tap away below.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn-primary">Home</a>
        <a href="/programmes" class="btn-ghost-light">Programmes</a>
        <a href="/contact" class="btn-ghost-light">Contact</a>
      </div>
    </div>
  </section>
</Base>
