---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProgramCard from '../components/ProgramCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { cta, programs, site } from '../data/site';
import heroPhoto from '../assets/photos/p13.jpg';

const juniors = programs.filter((p) => p.group === 'junior');
const adults = programs.filter((p) => p.group === 'adult');
const camps = programs.filter((p) => p.group === 'camp');
const social = programs.filter((p) => p.group === 'social');

const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const tone: Record<string, string> = {
  junior: 'border-navy/20 bg-shuttle-100 text-ink-900',
  adult: 'border-ink-900/15 bg-ink-900 text-white',
  camp: 'border-volt-500/40 bg-volt-500/10 text-ink-900',
  social: 'border-ink-200 bg-white text-ink-900',
};
const slotsFor = (day: string) =>
  programs
    .filter((p) => p.group !== 'camp' && p.days.includes(day))
    .sort((a, b) => a.time.localeCompare(b.time));
---

<Base
  title="Programmes & Timetable"
  description="BAPN training programmes in Christchurch — four junior tiers, adult social and representative squads, school holiday camps and Saturday social club."
>
  <PageHero
    eyebrow="Programmes"
    title="A tier for every player, from first racket to representative level."
    lead="Term programmes run through the school terms at Zhu Badminton Centre, Wigram. Juniors train twice a week, adults once. Holiday camps run in the school holidays."
    photo={heroPhoto}
    photoAlt="Juniors training on court at Zhu Badminton Centre"
  />

  <!-- Juniors -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-navy">Juniors · ages 7–17</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Four tiers. One pathway.</h2>
        <p class="mt-4 text-ink-600">
          Players start where they are and move up as they're ready. Tiers 4 to 2 are open entry;
          Tier 1 is by selection. Every tier trains twice a week through the school term.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {juniors.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>

  <!-- Adults -->
  <section class="border-t border-ink-100 bg-white py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-navy">Adults</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
          Badminton isn't just for juniors.
        </h2>
        <p class="mt-4 text-ink-600">
          Adult players train with the same structure and standards — and it shows when it counts.
          BAPN adults came home from the 2026 NZ Masters National Championships with a haul of
          titles.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {adults.map((program) => <ProgramCard program={program} />)}
        {social.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>

  <!-- Camps -->
  <section class="border-t border-ink-100 bg-shuttle-50 py-16 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-navy">School holidays</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Holiday camps</h2>
        <p class="mt-4 text-ink-600">
          A full week, Monday to Friday, 9am to 3pm, for ages 7–17 at every level. Skills in the
          morning, games and tournament play in the afternoon, and our partner health professionals
          drop in for practical sessions on recovery and nutrition.
        </p>
        <p class="mt-4 text-ink-600">
          Camps run in either the first or second week of each school holiday — dates are announced
          each term. Enrolments close the Monday before the camp starts, or earlier if it's full.
        </p>
        <p class="mt-4 text-sm text-ink-500">
          Can't make the full week? Tell us which days when you sign up — a minimum of three days
          applies.
        </p>
      </div>
      <div class="lg:col-span-7">
        <div class="grid gap-6 md:grid-cols-2">
          {camps.map((program) => <ProgramCard program={program} />)}
          <div class="flex flex-col justify-center rounded-2xl border border-ink-100 bg-white p-6">
            <p class="eyebrow text-ink-400">Private coaching</p>
            <h3 class="mt-3 text-xl font-bold tracking-tight text-ink-900">One-on-one with a head coach</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">
              Individual sessions by arrangement, for players working on something specific or
              preparing for a tournament. Members get $10 off every private session.
            </p>
            <a href="/contact?topic=private" class="btn-ghost mt-5 text-center">Ask about private coaching</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Weekly timetable -->
  <section class="border-t border-ink-100 bg-white py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow text-navy">Weekly timetable</p>
          <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">A training week at BAPN</h2>
          <p class="mt-4 text-ink-600">
            All sessions at {site.venue.name}, {site.venue.address}, {site.venue.suburb}. Terms
            follow the Canterbury school terms — ten weeks each — and term dates are published here
            before each term.
          </p>
        </div>
        <a href={cta.href} class="btn-dark">{cta.label} for a programme</a>
      </div>

      <!-- Phones: one row per day. Wider screens: seven columns. -->
      <div class="mt-10 grid gap-3 md:grid-cols-7">
        {
          days.map((day) => {
            const slots = slotsFor(day);
            return (
              <div
                class:list={[
                  'flex items-start gap-3 rounded-2xl border border-ink-100 bg-shuttle-50 p-3 md:block',
                  slots.length === 0 && 'hidden md:block',
                ]}
              >
                <p class="w-12 shrink-0 pt-3 text-xs font-bold uppercase tracking-widest text-ink-400 md:w-auto md:pt-0 md:text-center">
                  {day}
                </p>
                <div class="grid flex-1 gap-2 md:mt-3">
                  {slots.length === 0 ? (
                    <p class="py-6 text-center text-xs text-ink-400">—</p>
                  ) : (
                    slots.map((slot) => (
                      <div class={`rounded-xl border p-3 ${tone[slot.group]}`}>
                        <p class="text-[0.7rem] font-semibold opacity-80">{slot.time}</p>
                        <p class="mt-1 text-sm font-bold leading-snug">{slot.name}</p>
                      </div>
                    ))
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
      <p class="mt-4 text-xs text-ink-400">Holiday camps aren't shown — they run 9am–3pm, Monday to Friday, in the school holidays.</p>
    </div>
  </section>

  <!-- Schools -->
  <section class="border-t border-ink-100 bg-shuttle-50 py-16 md:py-24">
    <div class="container-x grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow text-navy">BAPN in schools</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
          Coaching partner to Canterbury schools.
        </h2>
        <p class="mt-4 text-ink-600">
          BAPN coaches run weekly sessions and tournament support for school badminton programmes.
          Rangi Ruru Girls' High School, coached by BAPN, won back-to-back gold at the South Island
          Secondary Schools Championships.
        </p>
        <p class="mt-4 text-ink-600">
          If your school would like coaching, a term block or help preparing for a tournament, get
          in touch and we'll build something around your timetable.
        </p>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <a href="/contact?topic=schools" class="btn-dark">Talk to us about your school</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure which tier fits?"
    body="Tell us the player's age and experience and we'll point you at the right session."
  />
</Base>
