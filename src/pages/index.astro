---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CoachCard from '../components/CoachCard.astro';
import ProgramCard from '../components/ProgramCard.astro';
import CtaBand from '../components/CtaBand.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { coaches, cta, news, partners, programs, site, stats } from '../data/site';
import hero from '../assets/photos/hero-sean.jpg';
import workshop from '../assets/photos/p11.jpg';

const featured = programs.filter((p) => p.featured);
const headCoaches = coaches.filter((c) => c.role.startsWith('Head Coach'));
const latest = news.slice(0, 3);
---

<Base title={site.name}>
  <!-- Hero -->
  <section class="court-lines relative overflow-hidden bg-ink-950">
    <div
      class="pointer-events-none absolute -left-32 top-1/4 h-96 w-96 rounded-full bg-volt-500/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="container-x relative grid gap-10 py-14 md:py-24 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow text-volt-300">Christchurch · juniors and adults</p>
        <h1 class="mt-5 text-balance text-display font-black leading-[0.97] tracking-tight text-white">
          Beyond the court,<br />
          <span class="text-volt-300">beyond limits.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-200">
          {site.longName}. BWF-certified head coaches, a structured pathway from first racket to
          representative level, and recovery and nutrition built into the training — for juniors
          from age 7 and for adults.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={cta.href} class="btn-primary">{cta.label}</a>
          <a href="/programmes" class="btn-ghost-light">See the programmes</a>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <span class="text-xs font-semibold uppercase tracking-widest text-ink-400">Follow</span>
          {
            site.socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-ink-200 underline decoration-volt-400/60 underline-offset-4 transition hover:text-volt-300"
              >
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative aspect-4/5 overflow-hidden rounded-3xl border border-ink-700 bg-ink-800 shadow-2xl shadow-black/40">
          <Image
            src={hero}
            alt="A BAPN player mid jump-smash at a tournament"
            width={900}
            height={1125}
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>

    <!-- Stat strip -->
    <div class="relative border-t border-ink-800">
      <div class="container-x grid grid-cols-2 gap-px lg:grid-cols-4">
        {
          stats.map((s) => (
            <div class="py-7 pr-6">
              <p class="text-3xl font-black tracking-tight text-volt-300">{s.value}</p>
              <p class="mt-1 text-xs leading-snug text-ink-300">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why BAPN -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-navy">Why BAPN</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
          Founded by three Badminton Canterbury coaches who wanted a better pathway.
        </h2>
        <p class="mt-4 text-ink-600">
          Players in Christchurch didn't always have access to experienced coaches, structured
          training or a clear way to improve. BAPN was started to be the programme every player
          deserves.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          [
            [
              'A clear pathway',
              'Four junior tiers from Foundation to Elite, and two adult tiers. High standards at every level, and somewhere to go next.',
            ],
            [
              'Coaches who\'ve been there',
              'Head coaches with BWF Level 1 and 2 certification, Badminton Canterbury head-coach roles, and national and international playing careers.',
            ],
            [
              'The "N" — recovery and nutrition',
              'A registered physiotherapist and a chiropractor run practical sessions in the training environment — fuelling, stretching, muscle release and injury awareness.',
            ],
          ].map(([title, body], i) => (
            <div class="rounded-2xl border border-ink-100 bg-white p-6">
              <span class="text-sm font-black tracking-widest text-volt-500">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-bold tracking-tight text-ink-900">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Programmes -->
  <section class="border-t border-ink-100 bg-white py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow text-navy">Programmes</p>
          <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Find the right session.</h2>
          <p class="mt-4 text-ink-600">
            Term programmes run through the school terms at Zhu Badminton Centre. Holiday camps
            run in the first or second week of each school holiday.
          </p>
        </div>
        <a href="/programmes" class="btn-ghost">All programmes &amp; timetable</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {featured.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>

  <!-- Coaches -->
  <section class="border-t border-ink-100 bg-shuttle-50 py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow text-navy">The coaches</p>
          <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">
            Coached by people who've competed at the level you're aiming for.
          </h2>
        </div>
        <a href="/about#coaches" class="btn-ghost">Meet the whole team</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {headCoaches.map((coach) => <CoachCard coach={coach} compact />)}
      </div>
    </div>
  </section>

  <!-- Nutrition / the N -->
  <section class="court-lines bg-ink-900 py-16 md:py-24">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow text-volt-300">Performance &amp; nutrition</p>
        <h2 class="mt-3 text-h2 font-black tracking-tight text-white">
          Looking after the body is part of the game.
        </h2>
        <p class="mt-4 text-ink-200">
          How players fuel, recover and handle soreness matters as much to their development as
          time on court. So BAPN brings qualified health professionals into training: practical
          sessions on food and hydration, stretching and muscle release, and telling normal
          soreness from an injury.
        </p>
        <a href="/about#nutrition" class="btn-ghost-light mt-6">How it works</a>
      </div>
      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-3xl border border-ink-700">
          <Image
            src={workshop}
            alt="BAPN players in a recovery and nutrition workshop"
            width={1200}
            height={800}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="bg-shuttle-50 py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-navy">Results &amp; news</p>
          <h2 class="mt-3 text-h2 font-black tracking-tight text-ink-900">Latest from the academy</h2>
        </div>
        <a href="/news" class="btn-ghost">All news</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          latest.map((item) => (
            <a
              href={`/news/${item.slug}`}
              class="flex h-full flex-col rounded-2xl border border-ink-100 bg-white p-6 transition hover:border-navy/40 hover:shadow-lg hover:shadow-ink-900/5"
            >
              <div class="flex items-center gap-3 text-xs">
                <span class="rounded-full bg-navy px-2.5 py-1 font-bold text-white">{item.category}</span>
                <time class="font-medium text-ink-400">{item.date}</time>
              </div>
              <h3 class="mt-4 text-lg font-bold leading-snug tracking-tight text-ink-900">{item.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{item.excerpt}</p>
              <span class="mt-5 text-sm font-bold text-volt-500">Read more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="border-t border-ink-100 bg-white py-14">
    <div class="container-x">
      <p class="eyebrow text-center text-ink-400">Our partners</p>
      <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        {partners.map((p) => <PartnerLogo partner={p} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
